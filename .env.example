# HRM SQE Agent Test Generator - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# API Keys (Required for full functionality)
# =============================================================================

# OpenAI API Key - Required for SQE Agent with GPT models
OPENAI_API_KEY=

# Anthropic API Key - Required for SQE Agent with Claude models
ANTHROPIC_API_KEY=

# Pinecone API Key - Required only if using Pinecone as RAG backend
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp

# Weights & Biases API Key - Optional for experiment tracking
WANDB_API_KEY=

# =============================================================================
# Application Configuration
# =============================================================================

# Environment: development, staging, production
HRM_ENV=development

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
HRM_LOG_LEVEL=INFO

# Enable debug mode (true/false)
HRM_DEBUG=false

# =============================================================================
# API Server Configuration
# =============================================================================

# API host and port
HRM_API_HOST=0.0.0.0
HRM_API_PORT=8000

# Number of worker processes
HRM_API_WORKERS=4

# Request timeout in seconds
HRM_REQUEST_TIMEOUT=300

# Rate limiting (requests per minute)
HRM_RATE_LIMIT_PER_MINUTE=100

# CORS origins (comma-separated, * for all)
HRM_CORS_ORIGINS=*

# =============================================================================
# Model Configuration
# =============================================================================

# Path to HRM model checkpoint
HRM_MODEL_PATH=checkpoints_hrm_v9_optimized_step_7566

# Default checkpoint step
HRM_DEFAULT_CHECKPOINT=step_7566

# Device: cuda, cpu, mps (auto-detected if not set)
HRM_DEVICE=

# Enable mixed precision (true/false)
HRM_MIXED_PRECISION=false

# =============================================================================
# RAG Configuration
# =============================================================================

# RAG backend: chromadb or pinecone
HRM_RAG_BACKEND=chromadb

# Vector store persistence directory
HRM_VECTOR_STORE_DIR=vector_store_db

# RAG collection name
HRM_RAG_COLLECTION=test_cases_requirements

# Embedding model
HRM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of similar items to retrieve
HRM_RAG_TOP_K=5

# Minimum similarity threshold (0.0-1.0)
HRM_RAG_MIN_SIMILARITY=0.7

# =============================================================================
# SQE Agent Configuration
# =============================================================================

# LLM provider: openai or anthropic
HRM_LLM_PROVIDER=openai

# LLM model name
HRM_LLM_MODEL=gpt-4

# LLM temperature (0.0-1.0)
HRM_LLM_TEMPERATURE=0.7

# LLM max tokens
HRM_LLM_MAX_TOKENS=2000

# =============================================================================
# Generation Configuration
# =============================================================================

# Generation mode: hrm_only, sqe_only, hybrid
HRM_GENERATION_MODE=hybrid

# Merge strategy: weighted, union, intersection
HRM_MERGE_STRATEGY=weighted

# HRM weight in hybrid mode (0.0-1.0)
HRM_HRM_WEIGHT=0.6

# SQE weight in hybrid mode (0.0-1.0)
HRM_SQE_WEIGHT=0.4

# Generation batch size
HRM_BATCH_SIZE=8

# Generation temperature
HRM_GENERATION_TEMPERATURE=0.8

# =============================================================================
# Fine-Tuning Configuration
# =============================================================================

# Number of training epochs
HRM_FINETUNE_EPOCHS=3

# Fine-tuning learning rate
HRM_FINETUNE_LR=2e-5

# Fine-tuning batch size
HRM_FINETUNE_BATCH_SIZE=16

# =============================================================================
# Drop Folder Configuration
# =============================================================================

# Drop folder base directory
HRM_DROP_FOLDER_DIR=drop_folder

# Watch interval in seconds
HRM_DROP_FOLDER_INTERVAL=5

# Debounce delay in seconds
HRM_DROP_FOLDER_DEBOUNCE=2

# Archive processed files (true/false)
HRM_DROP_FOLDER_ARCHIVE=true

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Enable Prometheus metrics (true/false)
HRM_METRICS_ENABLED=true

# Metrics port
HRM_METRICS_PORT=9090

# Enable distributed tracing (true/false)
HRM_TRACING_ENABLED=false

# Jaeger/OTLP endpoint
HRM_TRACING_ENDPOINT=

# =============================================================================
# Database Configuration (if using external databases)
# =============================================================================

# PostgreSQL connection (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/hrm_db

# Redis connection (for caching)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Security Configuration
# =============================================================================

# API authentication secret key (generate with: openssl rand -hex 32)
HRM_SECRET_KEY=

# JWT token expiry in hours
HRM_JWT_EXPIRY_HOURS=24

# Enable path validation (true/false)
HRM_VALIDATE_PATHS=true

# Maximum file size in MB
HRM_MAX_FILE_SIZE_MB=100

# =============================================================================
# Docker Configuration
# =============================================================================

# Container user ID (for volume permissions)
DOCKER_UID=1000
DOCKER_GID=1000

# GPU device IDs (comma-separated for multi-GPU)
NVIDIA_VISIBLE_DEVICES=all
